{
  "name": "backend-master",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --runInBand --forceExit --coverage --json --outputFile=reports/jest/jest-results.json",
    "nfr:seed": "node nfr/seed/seedQaUsers.js",
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "web-search:check": "node scripts/checkWebSearch.js",
    "data:audit": "node scripts/crmDataAudit.js",
    "data:audit:internal": "node scripts/internalIndustrialAudit.js",
    "data:test-review": "node scripts/testDataReview.js",
    "data:deletion-report": "node scripts/futureDeletionReport.js",
    "data:plan": "node scripts/crmDataAudit.js && node scripts/crmDataPlan.js",
    "db:backup": "node scripts/dbBackup.js",
    "sync:companies": "node scripts/syncCompanies.js",
    "sync:engineers": "node scripts/syncEngineers.js",
    "sync:architects": "node scripts/syncArchitects.js",
    "sync:people": "node scripts/syncPeople.js",
    "link:companies": "node src/scripts/linkProjectsToCompanies.js",
    "migrate:pipeline": "node src/scripts/run-pipeline-migration.js",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo",
    "db:seed:pipeline": "npx sequelize-cli db:seed --seed src/seeders/pipeline-stages.seeder.js",
    "db:seed:superadmin-cbi": "npx sequelize-cli db:seed --seed src/seeders/superadmin-cbi.seeder.js"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/setupTestEnv.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/Dash Master Toolkit/"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/migrations/**",
      "!src/seeders/**",
      "!src/scripts/**",
      "!src/diagnostics/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text-summary",
      "lcov",
      "json-summary"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@langchain/core": "^1.2.3",
    "@napi-rs/canvas": "^1.0.11",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dayjs": "^1.11.20",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.1.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.13",
    "pdf2json": "^4.0.3",
    "pdfjs-dist": "^3.11.174",
    "pdfkit": "^0.15.0",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "prom-client": "^15.1.3",
    "redis": "^4.7.1",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.1",
    "tesseract.js": "^7.0.0",
    "twilio": "^6.0.2",
    "ua-parser-js": "^2.0.10",
    "uuid": "^11.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.11",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2"
  }
}
