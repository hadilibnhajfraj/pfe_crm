# ================== API CONFIG ==================
PORT=4000

# ================== DATABASE ===================
DB_HOST=127.0.0.1


DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DATABASE_URL=postgres://your_db_user:your_db_password@127.0.0.1:5432/your_db_name

# ============== JWT KEYS & TOKENS ==============
JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET_32_CHARS
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d



# ============= reCAPTCHA (DEV) ================
# En dev tu peux laisser RECAPTCHA_SECRET vide,
# le backend loggue "[reCAPTCHA] No SECRET configured. Skipping verification (DEV ONLY)."
RECAPTCHA_SECRET=your_recaptcha_secret_key

# ============= SMTP / EMAIL (GMAIL) ============
##EMAIL_HOST=smtp.gmail.com
# ============= SMTP / EMAIL (HOSTINGER) ============
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_USER=your_email_account@example.com
EMAIL_PASS=your_email_account_password
EMAIL_SECURE=false
EMAIL_FROM="Your App Name" <no-reply@example.com>

# ============= AUTOMATIC EMAILS (CRON JOBS) ============
# Master switch for ALL automatic/scheduled email cron jobs (relance, follow-up, etc.).
# Read by: src/services/scheduler.js, src/cron/checkProjects.js, src/cron/projectCron.js,
# src/cron/followup.job.js, src/services/reminderService.js.
# Default: DISABLED. Set to "true" only when you want the CRM to resume sending automatic emails.
AUTO_EMAIL_JOBS_ENABLED=false

# Proactive AI — surveille projets/ventes/activités/échéances/interventions/KPI
# sans qu'une question soit posée, envoie une alerte réelle (e-mail + notification
# + push temps réel) quand un risque est détecté (voir src/ai/proactive/PROACTIVE_AI.md).
# Read by: src/cron/proactiveAiMonitor.job.js. Garde-fou DÉDIÉ, distinct de
# AUTO_EMAIL_JOBS_ENABLED ci-dessus. Default: DISABLED.
AI_PROACTIVE_MONITORING_ENABLED=false
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=change_me_now
SUPERADMIN_1_EMAIL=superadmin1@example.com
SUPERADMIN_1_PASSWORD=change_me_now


# ── Google Calendar OAuth2 (voir GOOGLE_CALENDAR_SETUP.md) ─────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/google-calendar/oauth/callback
GOOGLE_TOKEN_ENC_KEY=REPLACE_WITH_A_64_CHAR_HEX_ENCRYPTION_KEY_openssl_rand_hex_32
# URL HTTPS PUBLIQUE du backend, utilisée pour enregistrer le canal push
# Google Calendar (events.watch) — sync entrante Google -> CRM. Laisser vide
# en dev local (localhost n'est pas joignable par Google) : le système
# continue de fonctionner en écriture CRM -> Google uniquement. Exemple prod :
# GOOGLE_CALENDAR_WEBHOOK_BASE_URL=https://api.crmprobar.com
GOOGLE_CALENDAR_WEBHOOK_BASE_URL=https://api.yourdomain.com

# ── Demandes d'archivage/désarchivage — lien CRM inclus dans les emails ────
APP_URL=https://www.yourdomain.com

# ── WhatsApp (Twilio) — notifications des demandes d'archivage ────────────
# Tant que les 3 variables TWILIO_* ne sont pas renseignées, l'envoi WhatsApp
# est silencieusement ignoré (src/services/whatsapp.service.js ne lève jamais
# d'exception). Renseignez-les pour activer l'envoi réel.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=
# Numéro WhatsApp de cbitunisia@cbi-tunisia.com qui recevra les notifications
# de nouvelles demandes (format E.164, ex: +21612345678).
# CBI_ADMIN_WHATSAPP_NUMBER=

JWT_MFA_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET_32_CHARS

# MFA — voir src/config/mfaConfig.js. true = comportement actuel (OTP email), false = bypass complet (login classique email+mdp). Repasser a true pour reactiver le MFA sans changement de code.
MFA_ENABLED=false

# ── AI Business Copilot (src/ai) — infrastructure uniquement, désactivé par défaut ──
# Voir AI-Business-Copilot/00_PLAN_DEVELOPPEMENT.md (§10.3, §10.4) et src/ai/README.md.
# Master switch : false/absent = le kernel IA est chargé mais totalement inerte
# (AiManager.isEnabled() / isRoleAllowed() renvoient toujours false).
AI_COPILOT_ENABLED=true
# Liste de rôles séparés par des virgules — rôles RÉELS (src/models/User.js,
# ENUM) : user, commercial, accueil, admin, superadmin, superadmin2,
# responsable_logistique_achat ("user" = rôle standard par défaut de tout
# compte CRM). Vide = tous les rôles autorisés une fois AI_COPILOT_ENABLED=true.
AI_COPILOT_ROLES_ALLOWED=admin,superadmin,superadmin2,commercial,user,responsable_logistique_achat
# Fournisseur LLM réel — désormais consommé (src/ai/services/providers/) :
# vide/absent = Copilot inerte pour tout ce qui nécessite une réponse en
# langage naturel (createLlmProvider() renvoie null, AiManager.llmProvider
# reste null, AIManager.handleMessage() échoue proprement en NotConfiguredError,
# jamais un crash). Valeurs supportées : "openai" (API Chat Completions,
# aussi compatible Azure OpenAI/gateways OpenAI-compatibles), "anthropic"
# (API Messages) ou "ollama" (serveur LOCAL, gratuit, sans clé — voir
# bloc dédié ci-dessous). Toute autre valeur fait échouer le démarrage avec
# un message explicite (ConfigurationError) — une faute de frappe ici doit
# être visible immédiatement, pas découverte plus tard sur un Copilot muet.
# Ne jamais committer de vraie clé ici — voir le constat P0 sur ce fichier
# dans CRM_Architecture_Complète.pdf avant d'y placer un secret. La clé se
# nomme AI_LLM_API_KEY dans CE projet, quel que soit le fournisseur choisi —
# jamais OPENAI_API_KEY/ANTHROPIC_API_KEY (noms "standards" d'autres projets,
# non lus par ce code — voir createLlmProvider(), src/ai/services/providers/).
AI_LLM_PROVIDER=openai
AI_LLM_MODEL=gpt-4o-mini
AI_LLM_API_KEY=<set-locally>

# Ollama (fournisseur LOCAL, gratuit — src/ai/services/providers/ollamaProvider.js) :
# un serveur Ollama tournant sur CETTE machine (ou accessible sur le réseau
# local), jamais un service tiers. AUCUNE clé API — Ollama est non
# authentifié par conception ; ne jamais exposer son port sur Internet, ne
# jamais l'appeler depuis Flutter (Flutter ne parle qu'au backend Node.js).
# Pour l'utiliser : AI_LLM_PROVIDER=ollama ci-dessus (AI_LLM_API_KEY devient
# alors inutile pour ce fournisseur). OLLAMA_MODEL, si renseigné, prend le
# pas sur AI_LLM_MODEL pour ce fournisseur uniquement (permet de garder
# AI_LLM_MODEL="gpt-4o-mini" pendant qu'on expérimente Ollama en local, sans
# les faire s'écraser l'un l'autre) ; sinon AI_LLM_MODEL est réutilisé tel
# quel. OLLAMA_BASE_URL est optionnel — défaut : http://localhost:11434.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Optionnel — remplace le timeout par défaut d'OllamaProvider (180000ms,
# voir DEFAULT_TIMEOUT_MS dans ollamaProvider.js). L'inférence locale peut
# légitimement prendre plusieurs dizaines de secondes selon le matériel et
# le modèle — jamais utilisé par OpenAI/Anthropic (chacun garde son propre
# timeout, non lié à celui-ci). Une valeur absente ou invalide retombe
# silencieusement sur le défaut du code, jamais un crash au démarrage.
OLLAMA_TIMEOUT_MS=240000
